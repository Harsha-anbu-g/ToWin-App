{
  "expo": {
    "name": "Towinly",
    "slug": "towin",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "towin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f4ef",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#f6f4ef",
      "resizeMode": "contain"
    },
    "extra": {
      "apiBaseUrl": "https://backend-production-cef3.up.railway.app/api"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.towin.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.towin.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6f4ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Towinly uses your photo library so you can choose a profile picture.",
          "cameraPermission": "Towinly uses your camera only if you choose to take a new profile picture.",
          "microphonePermission": "Towinly uses the microphone only if you record a video for your profile picture."
        }
      ]
    ]
  }
}
