{
  "expo": {
    "name": "ToWin",
    "slug": "towin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "towin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf9f5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#faf9f5",
      "resizeMode": "contain"
    },
    "extra": {
      "apiBaseUrl": "https://backend-production-cef3.up.railway.app/api",
      "apiBaseUrlLocal": "http://192.168.0.13:8080/api"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.towin.app"
    },
    "android": {
      "package": "com.towin.app",
      "adaptiveIcon": {
        "backgroundColor": "#faf9f5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
