{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SHOW_DEMO": "1",
        "EXPO_PUBLIC_LEGAL_CONTACT_EMAIL": "help@towinly.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_LEGAL_CONTACT_EMAIL": "help@towinly.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
